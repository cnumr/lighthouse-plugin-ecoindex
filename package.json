{
  "name": "ecoindex-lighthouse-stack",
  "description": "Lighthouse plugin that include Ecoindex results.",
  "homepage": "https://github.com/cnumr/lighthouse-plugin-ecoindex#readme",
  "bugs": "https://github.com/cnumr/lighthouse-plugin-ecoindex/issues",
  "private": true,
  "author": {
    "name": "Renaud Héluin",
    "email": "renaud.heluin@novagaia.fr",
    "url": "https://novagaia.fr"
  },
  "contributors": [
    {
      "name": "Renaud Héluin",
      "email": "rheluin@novagaia.fr"
    },
    {
      "name": "Jérôme Moly@capybarbu",
      "email": "jerome@capybara.consulting"
    }
  ],
  "keywords": [
    "lighthouse",
    "plugin",
    "ecoindex",
    "GreenIT.fr"
  ],
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "doc": "cd docs && retype start",
    "update:libs": "pnpm update:puppeteer && pnpm update:lighthouse",
    "update:puppeteer": "sh scripts/update-puppeteer.sh",
    "update:lighthouse": "sh scripts/update-lighthouse.sh",
    "clean": "pnpm clean:npm && pnpm clean:lighthouseci",
    "clean:npm": "find . -maxdepth 3 -iname 'node_modules' | xargs rm -rf",
    "clean:dist": "find . -maxdepth 3 -iname 'dist' | xargs rm -rf",
    "clean:lighthouseci": "find . -maxdepth 3 -iname '.lighthouseci' | xargs rm -rf",
    "install:husky": "husky",
    "pnpm:list": "pnpm list --recursive --depth -1",
    "prettier": "prettier --write ./**/*",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "build": "turbo run build",
    "test": "sh scripts/test-sequencially.sh",
    "test:server:start": "node test/ensure-test-server.mjs start",
    "test:server:stop": "node test/ensure-test-server.mjs stop",
    "test:server:check": "node test/ensure-test-server.mjs check",
    "schema:create": "./scripts/manage-schema.sh create",
    "schema:update": "./scripts/manage-schema.sh update",
    "check:i18n": "npx tsx scripts/check-i18n-coverage.ts",
    "typecheck": "turbo run typecheck",
    "typecheck:strict": "tsc --noEmit -p apps/ecoindex-lh-cli/tsconfig.json && tsc --noEmit -p libs/ecoindex-lh-courses/tsconfig.json && tsc --noEmit -p libs/ecoindex-lh-plugin-ts/tsconfig.json",
    "format:write": "turbo run format:write",
    "format:check": "turbo run format:check",
    "publish-packages": "turbo lint build test && changeset version && changeset publish",
    "version": "changeset version",
    "release": "changeset publish",
    "vite:start": "pnpm --filter vite-electron-app start",
    "vite:make": "pnpm --filter vite-electron-app make",
    "react:start": "pnpm --filter react-electron-app start",
    "react:make": "pnpm --filter react-electron-app make",
    "lhci:server:start": "docker compose -f tools/lhci-server/docker-compose.yml up -d",
    "lhci:server:stop": "docker compose -f tools/lhci-server/docker-compose.yml down",
    "lhci:install:git-lfs": "sh tools/lhci-server/install-git-lfs.sh",
    "refs:update": "tsx scripts/generate-refs-urls.ts",
    "refs:update:version": "tsx scripts/generate-refs-urls.ts -- --version",
    "i18n:extract": "tsx scripts/i18n-extract-patch.ts"
  },
  "prettier": {
    "arrowParens": "avoid",
    "singleQuote": true,
    "semi": false
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "test/*"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.19.4",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.34.1+sha256.b568bc5ee2b68a9735743c1b9f09b3d3065de64befaf186c5d01b2f084d16cc0",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.14",
      "fast-uri": "^3.1.2",
      "@lhci/cli>lighthouse": "13.2.0"
    }
  }
}
